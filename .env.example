# --- AegisForge example environment file ---
# Copy to `.env` and adjust. All variables are prefixed AEGIS_.

AEGIS_ENVIRONMENT=local
AEGIS_LOG_JSON=true
AEGIS_LOG_LEVEL=INFO

# Persistence
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./aegisforge.db

# LLM
# Options: mock | anthropic | openai | bedrock
AEGIS_LLM_PROVIDER=mock
AEGIS_LLM_MODEL=claude-sonnet-4-6
# AEGIS_ANTHROPIC_API_KEY=
# AEGIS_OPENAI_API_KEY=
AEGIS_LLM_MAX_TOKENS=1024
AEGIS_LLM_TIMEOUT_SECONDS=30

# Safety
AEGIS_ENABLE_AUTONOMOUS_ACTIONS=false
AEGIS_REQUIRE_HUMAN_APPROVAL=true

# GitOps / GitHub
# AEGIS_GITHUB_TOKEN=ghp_xxx
# AEGIS_GITHUB_REPOSITORY=mikegyim/aegisforge-infra
AEGIS_GITHUB_BASE_BRANCH=main
AEGIS_GITHUB_DRY_RUN=true

# API security
# AEGIS_API_KEY=replace-with-long-random-string
AEGIS_RATE_LIMIT_PER_MINUTE=60

# Observability
AEGIS_ENABLE_METRICS=true
AEGIS_ENABLE_TRACING=false
# AEGIS_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
